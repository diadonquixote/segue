# ---- API (apps/api) ----
PORT=8787
# Which places source to use: osm (free, default) | google | mock (offline demo data)
PLACES_PROVIDER=osm
# Only needed when PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Max re-routes per IP per hour
REROUTE_RATE_LIMIT=30

# ---- Web (apps/web) ----
VITE_API_URL=http://localhost:8787
