# ---- API (apps/api) ----
PORT=8787
# Which places source to use: osm (free, default) | google | mock (offline demo data)
PLACES_PROVIDER=osm
# Only needed when PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Max re-routes per IP per hour
REROUTE_RATE_LIMIT=60
# Smart add ("Let Segue read it"): on automatically when ANTHROPIC_API_KEY is set; SMART_ADD=off turns it off
ANTHROPIC_API_KEY=
# SMART_ADD=off
# Max smart-add notes per IP per hour (each one is a paid Claude call)
SMART_ADD_RATE_LIMIT=40

# ---- Web (apps/web) ----
VITE_API_URL=http://localhost:8787
