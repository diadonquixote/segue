{
  "name": "segue",
  "private": true,
  "description": "Segue \u2014 a day planner that re-routes itself when life goes off-script.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @segue/api dev",
    "dev:web": "pnpm --filter @segue/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @segue/web e2e"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
